  organizations {
    int id PK
    varchar name
    varchar slug
    timestamp created_at
  }

  users {
    int id PK
    int org_id FK
    varchar username
    varchar email
    varchar role
    varchar status
    varchar presence
    timestamp created_at
    timestamp updated_at
  }

  teams {
    int id PK
    int org_id FK
    varchar name
    int created_by FK
    timestamp created_at
  }

  team_members {
    int team_id PK, FK
    int user_id PK, FK
    varchar role
    timestamp joined_at
  }

  project_statuses {
    int id PK
    varchar key
    varchar name
  }

  projects {
    int id PK
    int team_id FK
    int project_status_id FK
    int project_manager_id FK
    int created_by FK
    varchar name
    timestamp created_at
  }

  task_statuses {
    int id PK
    varchar key
    varchar name
  }

  tasks {
    int id PK
    int project_id FK
    int task_status_id FK
    int assignee_id FK
    int parent_task_id FK
    varchar title
    timestamp created_at
  }

  task_assignees {
    int task_id PK, FK
    int user_id PK, FK
    timestamp assigned_at
  }

  tags {
    int id PK
    varchar key
    varchar name
  }

  task_tags {
    int task_id PK, FK
    int tag_id PK, FK
  }

  task_dependencies {
    int id PK
    int task_id FK
    int depends_on_task_id FK
    varchar type
  }

  task_comments {
    int id PK
    int task_id FK
    int user_id FK
    text body
    timestamp created_at
  }

  task_time_logs {
    int id PK
    int task_id FK
    int user_id FK
    decimal hours
    timestamp logged_at
  }

  attachments {
    int id PK
    int project_id FK
    int task_id FK
    int uploaded_by FK
    varchar file_name
    varchar file_path
    timestamp uploaded_at
  }

  channels {
    int id PK
    int org_id FK
    int team_id FK
    int created_by FK
    varchar name
    varchar type
    timestamp created_at
  }

  messages {
    int id PK
    int channel_id FK
    int user_id FK
    int reply_to_id FK
    text content
    timestamp created_at
  }

  notifications {
    int id PK
    int user_id FK
    varchar title
    text body
    varchar url
    boolean is_read
    timestamp created_at
  }

  extension_requests {
    int id PK
    int task_id FK
    int requested_by FK
    int reviewed_by FK
    date current_due_date
    date requested_due_date
    int requested_extension_days
    varchar status
    varchar priority
    timestamp created_at
  }

  performance_records {
    int id PK
    int user_id FK
    varchar period
    decimal rating
    decimal productivity
    timestamp created_at
  }

  activity_log {
    int id PK
    int user_id FK
    varchar action
    varchar entity_type
    int entity_id
    timestamp created_at
  }

  workflow_rules {
    int id PK
    varchar name
    varchar trigger_event
    boolean active
    timestamp created_at
    timestamp updated_at
  }

  user_notification_settings {
    int user_id PK, FK
    boolean email
    boolean push
    boolean slack
    varchar frequency
    boolean types_tasks
    boolean types_projects
    boolean types_system
    boolean types_mentions
    timestamp updated_at
  }

  system_settings {
    int id PK
    varchar backup_frequency
    int backup_retention_days
    boolean security_2fa
    boolean security_strong_pw
    int session_timeout_minutes
    timestamp updated_at
  }