  users ||--o{ projects : manages
  users ||--o{ projects : creates

  projects ||--o{ tasks : has
  task_statuses ||--o{ tasks : categorizes
  users ||--o{ tasks : assigned
  tasks ||--o{ tasks : parent

  tasks ||--o{ task_assignees : has
  users ||--o{ task_assignees : assigned

  tags ||--o{ task_tags : links
  tasks ||--o{ task_tags : tagged

  tasks ||--o{ task_dependencies : depends
  tasks ||--o{ task_dependencies : required

  tasks ||--o{ task_comments : has
  users ||--o{ task_comments : writes

  tasks ||--o{ task_time_logs : logs
  users ||--o{ task_time_logs : logs

  projects ||--o{ attachments : has
  tasks ||--o{ attachments : has
  users ||--o{ attachments : uploads

  organizations ||--o{ channels : has
  teams ||--o{ channels : has
  users ||--o{ channels : creates
  channels ||--o{ messages : has
  users ||--o{ messages : sends
  messages ||--o{ messages : replies

  users ||--o{ notifications : receives

